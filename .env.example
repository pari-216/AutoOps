# ---------------------------------------------------------------
# AutoOps — environment variables
# Copy this file to .env.local and fill in your values.
#
# Supabase credentials:
#   Dashboard → Project Settings → API
#
# Phase 1 runs without these values.
# Phase 2 (auth) requires NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_ANON_KEY.
# Phase 3 (webhooks) additionally requires the three AUTOOPS_ variables.
# Phase 4 (AI agent) requires GROQ_API_KEY.
# Phase 6 (Gmail / Calendar / Zapier Outbound) requires Google OAuth & Zapier secrets.
# ---------------------------------------------------------------

# ── Supabase ────────────────────────────────────────────────────
# Public (safe for browser bundles)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret — server-only, NEVER prefix with NEXT_PUBLIC_
# Found in: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# ── Inbound Webhook (Phase 3) ───────────────────────────────────
# A random secret string you invent (min 32 chars recommended).
# Set the same value in Zapier → "Custom Request Header"
#   Header Name:  x-autoops-webhook-secret
#   Header Value: <this value>
AUTOOPS_WEBHOOK_SECRET=

# The Supabase auth.users UUID that owns ingested emails.
# Find it in: Supabase Dashboard → Authentication → Users → copy the UUID.
AUTOOPS_WEBHOOK_USER_ID=

# ── AI Reasoning (Phase 4) ─────────────────────────────────────
# Your Groq API key for AI agent email classification & drafting.
# Server-side only, NEVER prefix with NEXT_PUBLIC_
# Find it in: https://console.groq.com/keys
GROQ_API_KEY=

# ── Google OAuth for Gmail & Calendar (Phase 6) ──────────────────
# Found in: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# ── Zapier Outbound Webhook (Phase 6) ───────────────────────────
# Target URL created in Zapier Webhooks trigger for outbound execution.
ZAPIER_OUTBOUND_WEBHOOK_URL=
ZAPIER_OUTBOUND_WEBHOOK_SECRET=

# ── Cron Security (Gmail Ingestion Endpoint) ───────────────────
# Secret token to authenticate HTTP cron trigger requests.
# Configured in Vercel Environment Variables and passed by external scheduler (e.g. cron-job.org).
# Header required: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
